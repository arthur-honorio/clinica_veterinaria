@baseUrl = http://localhost:3000

### Listar tutores
GET {{baseUrl}}/tutores

### Buscar tutor existente
GET {{baseUrl}}/tutores/1

### Buscar tutor inexistente (espera 404)
GET {{baseUrl}}/tutores/999

### Cadastrar tutor 1
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "nome": "Álvaro",
  "telefone": "5585999991111",
  "endereco": "Rua 8"
}

### Cadastrar tutor 2
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "nome": "Ana Maria",
  "telefone": "5585988887777",
  "endereco": "Rua 4"
}

### Cadastrar tutor 3
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "nome": "João",
  "telefone": "5585990908989",
  "endereco": "Rua 1"
}

### Cadastrar tutor 4
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "nome": "Maria",
  "telefone": "5585989899090",
  "endereco": "Rua 2"
}

### Cadastrar com telefone inválido (espera 400)
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "nome": "Ana",
  "telefone": "85 9123-1234",
  "endereco": "Rua 3"
}

### Cadastrar sem nome (espera 400)
POST {{baseUrl}}/tutores
Content-Type: application/json

{
  "telefone": "5585999998888",
  "endereco": "Rua 3"
}

### Editar tutor (espera 200)
PUT {{baseUrl}}/tutores/3
Content-Type: application/json

{
  "nome": "João",
  "telefone": "5585988887777",
  "endereco": "Rua 4"
}

### Editar tutor inexistente (espera 404)
PUT {{baseUrl}}/tutores/999
Content-Type: application/json

{
  "nome": "Ninguém",
  "telefone": "5585988887777",
  "endereco": "Rua 4"
}

### Editar com telefone inválido (espera 400)
PUT {{baseUrl}}/tutores/3
Content-Type: application/json

{
  "nome": "Ana Maria",
  "telefone": "85 99992-0009",
  "endereco": "Rua 4"
}

### Remover tutor (espera 204)
DELETE {{baseUrl}}/tutores/4

### Remover tutor inexistente (espera 404)
DELETE {{baseUrl}}/tutores/999

### Remover tutor com animais (espera 409)
DELETE {{baseUrl}}/tutores/1
