@baseUrl = http://localhost:3000

### Cadastrar 1
POST {{baseUrl}}/animais
Content-Type: application/json

{
  "nome": "Dona Flor",
  "especie": "Gato",
  "raca": "Persa",
  "nascimento": "2026-02-24",
  "tutor_id": 1
}

